# Release signing — copy to android/key.properties (gitignored) and fill with YOUR keystore.
# Generate an upload keystore once:
#   keytool -genkey -v -keystore ~/voxa-upload.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias voxa-upload
storeFile=/absolute/path/to/voxa-upload.jks
storePassword=CHANGE_ME
keyAlias=voxa-upload
keyPassword=CHANGE_ME
