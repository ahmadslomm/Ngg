# voxa backend — copy to .env and fill with YOUR OWN values.
# NONE of these are the original app's credentials. Provision your own accounts.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Comma-separated browser origins allowed by CORS in production (web admin console).
# Leave empty for a mobile-only deployment. Ignored in non-production (all origins allowed).
CORS_ORIGINS=

# MUST be false in production. When false, a production build refuses the dev auth stub
# and dev RTC token (fail closed). The process will not even start in prod if this is true.
ALLOW_INSECURE_DEV_AUTH=false

# Postgres — use a strong password and a bounded pool in prod, e.g.
#   ?schema=public&connection_limit=20&pool_timeout=10
DATABASE_URL=postgresql://voxa:voxa@localhost:5432/voxa?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Back-office admin seed (REQUIRED in production; must be strong & non-default).
ADMIN_USER=root
ADMIN_PASS=

# Auth — in prod every secret below must be >=32 chars and NOT a placeholder (boot guard).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900          # 15 min
JWT_REFRESH_TTL=2592000     # 30 days

# Request signing (rotating; NOT the original 'awgwd^1ad87')
APP_SIGN_SECRET_CURRENT=generate-a-64-hex-secret
APP_SIGN_SECRET_PREVIOUS=
SIGN_SKEW_MS=300000
SIGN_ENFORCED=false         # MUST be true in prod (the process refuses to boot otherwise)

# At-rest field encryption (withdrawal payout accounts). MUST be a strong (>=32 char,
# non-placeholder) value in prod; the process refuses to boot otherwise. Rotating it makes
# previously-encrypted rows unreadable, so re-encrypt on rotation.
FIELD_ENCRYPTION_KEY=generate-a-strong-32plus-char-key

# Agora (YOUR account)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-cert
AGORA_TOKEN_TTL=3600

# Payments (YOUR merchant accounts)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_SHARED_SECRET=

# Push (YOUR Firebase project)
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# Cloudflare R2 (S3-compatible) object storage for user uploads (avatars, moment images,
# voice clips). All optional: if unset, POST /uploads/presign fails closed with 503 and the
# app falls back to its placeholder uploader. To enable, set ACCESS_KEY_ID / SECRET_ACCESS_KEY /
# BUCKET / PUBLIC_BASE_URL, plus ACCOUNT_ID (endpoint is derived) OR an explicit ENDPOINT.
#   - Create an R2 bucket + an API token (Object Read & Write) in the Cloudflare dashboard.
#   - PUBLIC_BASE_URL is the bucket's public read origin: a custom domain or its *.r2.dev URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voxa-media
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
# Max upload size the client enforces before requesting a URL (bytes; 10 MiB default).
UPLOAD_MAX_BYTES=10485760

# (Legacy S3 slots — superseded by the R2 block above; R2 is S3-compatible.)
S3_ENDPOINT=
S3_BUCKET=voxa-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
