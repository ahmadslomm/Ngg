<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="2.5dip" />
            <solid android:color="@color/xy" />
            <stroke android:width="1.0dip" android:color="@color/yj" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="2.5dip" />
                <gradient android:startColor="#ffffcc46" android:endColor="#ffff975b" android:angle="180.0" />
            </shape>
        </clip>
    </item>
</layer-list>