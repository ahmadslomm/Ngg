<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="49.5dip" />
            <gradient android:startColor="#ff16062e" android:endColor="#ff4c11a4" android:angle="270.0" />
            <stroke android:width="1.0dip" android:color="#26f2f6f7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="49.5dip" />
            <solid android:color="#26f2f6f7" />
        </shape>
    </item>
</selector>