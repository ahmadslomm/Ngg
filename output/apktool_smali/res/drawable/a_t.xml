<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="7.5dip" />
            <stroke android:width="1.0dip" android:color="#ff00d4f5" />
            <solid android:color="#26000006" />
            <size android:height="15.0dip" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="7.5dip" />
                <gradient android:startColor="#ff00d4f5" android:endColor="#fff264f5" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>