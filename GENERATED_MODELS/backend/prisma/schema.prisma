model RoomSeat {
  id           BigInt   @id @default(autoincrement())   // @notes("needs confirmation") surrogate PK
  pos                        Int?
  uid                        String?
  locked                     Boolean?
  op                         Int?
  status       SeatStatus? // @notes("needs confirmation")
  muted        MuteState?  // @notes("needs confirmation") from op
  roomId       BigInt?     // @notes("needs confirmation") FK->Room
  room         Room?    @relation(fields:[roomId],references:[id]) // @notes("needs confirmation")
  createdAt    DateTime @default(now())   // @notes("needs confirmation")
  updatedAt    DateTime @updatedAt        // @notes("needs confirmation")
  @@index([roomId])
}

