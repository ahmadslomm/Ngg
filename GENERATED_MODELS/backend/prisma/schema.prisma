// Prisma schema — reconstructed from decompiled ZaffaLive Gson models + decrypted API params.
// Field names/types come verbatim from the APK models (no invention). Lines tagged
// `@notes("needs confirmation")` are STRUCTURAL additions (surrogate id, timestamps, relations,
// RoomSeat, enums) inferred for a relational DB — verify against a live capture before trusting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- enums (structural; values need confirmation) ----
enum SeatStatus {  // @notes("needs confirmation")
  EMPTY
  OCCUPIED
  LOCKED
}

enum MuteState {  // @notes("needs confirmation")
  OFF
  ON
}

enum TransactionKind {  // @notes("needs confirmation")
  GIFT
  LUCKY
  DRAW
  SONG
  PRIVATE
}

enum TxDirection {  // @notes("needs confirmation")
  IN
  OUT
}

enum RoleType {  // @notes("needs confirmation")
  OWNER
  ADMIN
  MEMBER
}

