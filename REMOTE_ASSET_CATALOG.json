{
 "app": "ZaffaLive",
 "package": "com.waig.nalo",
 "note": "Catalog of every REMOTE asset-URL FIELD carried by server DTOs (from decrypted @hq4 keys). These fields hold runtime URLs the client loads; the actual URLs/CDN host are server-delivered and NOT in the APK (confirmed: 0 hardcoded CDN). To download the real assets: capture the catalog endpoints (gift.getGiftList, medal/VIP, activity.getBannerList, room themes) once and read these fields. Bundled (in-APK) assets are in COMPLETE_ASSET_MAP.json.",
 "delivering_endpoints_and_opcodes": {
  "gift art": "gift.getGiftList/getCommonGift/getClientGiftTabs ; IM 10600 (l63.svga_url/resource_url)",
  "vip frames/medals": "medal.* , room.getWealthInfo ; DTO t43 (avatarFrame/vipMedalImg/url_lv1..4)",
  "banners/activities": "activity.getBannerList , RoomAct.* (banner_url/act_url)",
  "room themes": "mall.buyTheme/useTheme , room.updateRoomInfo (themeUrl/bgImg)",
  "rocket/effects": "RocketGift.* , IM 11300 gq3.svga_url",
  "prizes": "luckyBags/LuckyDraw (prize_image/preview_url/zip_url)"
 },
