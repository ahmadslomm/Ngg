<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_checked="true" android:id="@id/gy" android:drawable="@drawable/fj" />
    <item android:id="@id/ou" android:drawable="@drawable/fj" app:aae="true" />
    <item android:state_checked="false" android:id="@id/ayk" android:drawable="@drawable/fk" />
    <transition android:drawable="@drawable/f5" android:toId="@id/ayk" android:fromId="@id/gy" />
    <transition android:drawable="@drawable/fc" android:toId="@id/gy" android:fromId="@id/ayk" />
    <transition android:drawable="@drawable/f5" android:toId="@id/ayk" android:fromId="@id/ou" />
    <transition android:drawable="@drawable/fc" android:toId="@id/ou" android:fromId="@id/ayk" />
</animated-selector>