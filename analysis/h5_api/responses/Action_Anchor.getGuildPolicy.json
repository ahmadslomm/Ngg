
{"response_status":{"error":""},"response_data":{"policy":["1. \u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u062d\u0635\u0631\u064a: \u064a\u0645\u0643\u0646 \u0644\u0643\u0644 \u0645\u0642\u062f\u0645 \u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u062a\u0639\u0627\u0642\u062f \u0645\u0639 \u0648\u0643\u0627\u0644\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637. \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0643\u062a\u0634\u0627\u0641 \u062a\u0639\u0627\u0642\u062f \u0645\u0632\u062f\u0648\u062c\u060c \u0633\u064a\u062a\u0645 \u062d\u062c\u0628 \u0643\u0627\u0645\u0644 \u0627\u0644\u062f\u062e\u0644 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0645\u0646\u0635\u0629.","2. \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0627\u0644\u0645\u0646\u0635\u0629: \u064a\u064f\u062d\u0638\u0631 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0628\u062b \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0645\u0646\u0627\u0642\u0634\u0629 \u0623\u0648 \u0627\u0644\u062a\u0631\u0648\u064a\u062c \u0644\u0623\u064a \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0646 \u0645\u0646\u0635\u0627\u062a \u0627\u0644\u0628\u062b \u0627\u0644\u0623\u062e\u0631\u0649. \u0633\u064a\u062a\u0645 \u062e\u0635\u0645 \u062c\u0645\u064a\u0639 \u0627\u0644\u0625\u064a\u0631\u0627\u062f\u0627\u062a \u0648\u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062a \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629.","3. \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0628\u0634\u0643\u0644 \u0642\u0627\u0646\u0648\u0646\u064a: \u064a\u064f\u0645\u0646\u0639 \u0645\u0646\u0639\u064b\u0627 \u0628\u0627\u062a\u064b\u0627 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0628\u0637\u0631\u0642 \u063a\u064a\u0631 \u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0645\u062b\u0644 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0645\u062f\u0641\u0648\u